{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -d node_modules || npm install; npm run build -s 2>/dev/null && echo 'Build OK' || echo 'WARNING: build is broken'",
            "statusMessage": "Verify environment ready"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node scripts/*)",
      "Bash(npx vite *)",
      "Bash(ls dist/*)",
      "Bash(ls src/*)"
    ]
  }
}
